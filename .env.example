# Local development only. Copy to .env. Never use these values in production.

ENVIRONMENT=development
LOG_LEVEL=INFO

# --- PostgreSQL (one database per bounded context) ---
AIRPORT_POSTGRES_USER=airport
AIRPORT_POSTGRES_PASSWORD=airport_dev_only
AIRPORT_POSTGRES_DB=airport_db
AIRPORT_DATABASE_URL=postgresql+asyncpg://airport:airport_dev_only@postgres-airport:5432/airport_db

ITINERARY_POSTGRES_USER=itinerary
ITINERARY_POSTGRES_PASSWORD=itinerary_dev_only
ITINERARY_POSTGRES_DB=itinerary_db
ITINERARY_DATABASE_URL=postgresql+asyncpg://itinerary:itinerary_dev_only@postgres-itinerary:5432/itinerary_db

NOTIFICATION_POSTGRES_USER=notification
NOTIFICATION_POSTGRES_PASSWORD=notification_dev_only
NOTIFICATION_POSTGRES_DB=notification_db
NOTIFICATION_DATABASE_URL=postgresql+asyncpg://notification:notification_dev_only@postgres-notification:5432/notification_db

# --- Redis (airport cache) ---
REDIS_PASSWORD=redis_dev_only
REDIS_URL=redis://:redis_dev_only@redis:6379/0
AIRPORT_CACHE_TTL_SECONDS=300

# --- RabbitMQ ---
RABBITMQ_USER=itinerary
RABBITMQ_PASSWORD=rabbitmq_dev_only
RABBITMQ_VHOST=/
RABBITMQ_URL=amqp://itinerary:rabbitmq_dev_only@rabbitmq:5672/

# Event topology (must match infra/rabbitmq/definitions.json)
RABBITMQ_EXCHANGE=itinerary.events
RABBITMQ_ROUTING_KEY=itinerary.created
RABBITMQ_QUEUE=notification.itinerary-created
RABBITMQ_DLX=itinerary.events.dlx
RABBITMQ_DLQ=notification.itinerary-created.dlq

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAMESPACE=personal-itinerary-system
JAEGER_UI_PORT=16686
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana_dev_only

# --- External airport provider (used from Phase 2) ---
API_COLOMBIA_BASE_URL=https://api-colombia.com
API_COLOMBIA_TIMEOUT_SECONDS=5

# --- Application (used from later phases) ---
API_BASE_URL=http://gateway:8000
GATEWAY_PORT=8000
AIRPORT_SERVICE_URL=http://airport-service:8000
ITINERARY_SERVICE_URL=http://itinerary-service:8000
REPORT_FUNCTION_URL=http://report-function:8000
AUTH_JWT_SECRET=dev_only_change_me_not_for_production
AUTH_JWT_ALGORITHM=HS256
